{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-residue-evidence.local/schemas/residue-report.schema.json",
  "title": "Agent Residue Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "task_id", "status", "created_at", "candidates"],
  "properties": {
    "schema_version": {"const": "agent-residue-report/1.0"},
    "report_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "status": {"enum": ["NO_CANDIDATES_OBSERVED", "REVIEW_REQUIRED", "PARTIAL_EVIDENCE", "INTERRUPTED_TASK", "OBSERVATION_FAILED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "candidates": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
