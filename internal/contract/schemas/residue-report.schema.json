{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-residue-evidence.local/schemas/residue-report.schema.json",
  "title": "Agent Residue Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "task_id", "status", "created_at", "candidates"],
  "properties": {
    "schema_version": {"const": "agent-residue-report/1.0"},
    "report_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "status": {"enum": ["NO_CANDIDATES_OBSERVED", "REVIEW_REQUIRED", "PARTIAL_EVIDENCE", "INTERRUPTED_TASK", "OBSERVATION_FAILED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "verified_at": {"type": "string", "format": "date-time"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "evidence_level", "current_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 256},
          "kind": {"enum": ["file", "directory", "process", "port"]},
          "path": {"type": "string"},
          "object_identity": {"type": "string"},
          "process": {"type": "object", "additionalProperties": false, "required": ["pid", "created_at"], "properties": {"pid": {"type": "integer", "minimum": 1}, "created_at": {"type": "string", "format": "date-time"}}},
          "parent_pid": {"type": "integer", "minimum": 0},
          "port": {"type": "object", "additionalProperties": false, "required": ["protocol", "address", "number"], "properties": {"protocol": {"const": "tcp"}, "address": {"type": "string", "minLength": 1}, "number": {"type": "integer", "minimum": 1, "maximum": 65535}}},
          "size_bytes": {"type": "integer", "minimum": 0},
          "evidence_level": {"enum": ["BASELINE_OBSERVED", "RECEIPT_BOUND", "EVENT_BOUND", "INFERRED", "UNATTRIBUTED"]},
          "current_status": {"enum": ["PRESENT", "ACTIVE_REFERENCE", "NO_LONGER_PRESENT", "CHANGED_SINCE_REPORT", "UNKNOWN"]},
          "reason": {"type": "string"},
          "recommendation": {"enum": ["review"]},
          "event_ids": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "receipt_ids": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "conflicts": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
